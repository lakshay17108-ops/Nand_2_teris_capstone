// Memory.hdl
// Capstone - Nand to Tetris I
// Lakshay Roll No 2501730367
//
// Address map:
//   0     - 16383  : RAM16K
//   16384 - 24575  : Screen
//   24576          : Keyboard

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[14] = 0 -> RAM16K, address[14] = 1 -> Screen / Keyboard
    DMux(in=load, sel=address[14], a=loadRam, b=loadScreen);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    // inside the upper half: address[13] = 0 -> Screen, 1 -> Keyboard
    Mux16(a=screenOut, b=kbdOut, sel=address[13], out=upperOut);
    Mux16(a=ramOut, b=upperOut, sel=address[14], out=out);
}
